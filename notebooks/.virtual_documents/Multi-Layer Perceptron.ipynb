data_path = "../data/"
df = pd.read_csv(f"{data_path}/session_test_3.csv", sep=";")

EEG_COLS = [c for c in df.columns if c != "eyeDetection" and c != "timestamp"]
TARGET = "eyeDetection"

df.iloc[:, 1:-1] = filter_data(df.iloc[:, 1:-1].values.T, FS, 1, 30).T

df = remove_artifacts_interpolate(df, EEG_COLS, 0.99, 0.01)


FS = 250  # sampling frequency (Hz)
WIN_SEC = 2.0  # window length in seconds
STEP_SEC = 0.5  # hop (50 % overlap)
WIN_SAMP = int(WIN_SEC * FS)
STEP_SAMP = int(STEP_SEC * FS)

BANDS = {
    "theta": (4, 8),
    "alpha": (8, 13),
    "beta": (13, 30),
    "gamma": (30, 100),
}


def band_power(sig: np.ndarray, fmin: float, fmax: float) -> float:
    """Average power in [fmin, fmax] Hz via Welch's method."""
    freqs, psd = welch(sig, fs=FS, nperseg=min(len(sig), 64))
    idx = (freqs >= fmin) & (freqs <= fmax)
    df_ = (freqs[1] - freqs[0]) if len(freqs) > 1 else 1.0
    return float(psd[idx].sum() * df_)


def extract_features(window: np.ndarray) -> np.ndarray:
    """window shape: (n_samples, n_channels) → 1-D feature vector."""
    feats = []
    for ch in range(window.shape[1]):
        sig = window[:, ch]
        for fmin, fmax in BANDS.values():
            feats.append(band_power(sig, fmin, fmax))
        mean = np.mean(sig)
        feats.append(np.std(sig) / mean if mean != 0 else 0.0)
    return np.array(feats, dtype=np.float32)


# Build windowed dataset
X_raw = df[EEG_COLS].values.astype(np.float32)
y_raw = df[TARGET].values.astype(int)

windows, labels = [], []
starts = range(0, len(X_raw) - WIN_SAMP + 1, STEP_SAMP)

for start in starts:
    end = start + WIN_SAMP
    windows.append(extract_features(X_raw[start:end]))
    labels.append(int(y_raw[start:end].max()))  # open if EVER open

X_np = np.vstack(windows)
y_np = np.array(labels)

# Feature names (for reference)
feat_names = [f"{ch}_{band}" for ch in EEG_COLS for band in list(BANDS) + ["cv"]]

print(f"Feature matrix : {X_np.shape}")
print(f"Class balance  : {np.bincount(y_np)}  (closed / open)")


scaler = StandardScaler()
X_scaled = scaler.fit_transform(X_np).astype(np.float32)

X_torch = torch.tensor(X_scaled)
y_torch = torch.tensor(y_np, dtype=torch.float32)

print(f"X_torch : {X_torch.shape}  dtype={X_torch.dtype}")
print(f"y_torch : {y_torch.shape}  dtype={y_torch.dtype}")


model = MLP(X_torch.shape[1], layer_sizes, dropout, activation, use_bn).to(DEVICE)
